---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/fraunces";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  htmlLang,
  locales,
  siteAssets,
  switchLocalePath,
  type Locale,
  type Translation,
} from "../i18n";

interface Props {
  locale: Locale;
  t: Translation;
  title: string;
  description?: string;
}

const { locale, t, title, description = t.site.description } = Astro.props;
const fullTitle =
  title === t.site.name ? `${t.site.name} — ${t.site.tagline}` : `${title} — ${t.site.name}`;
const canonical = Astro.url.href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href={siteAssets.favicon} sizes="32x32" />
    <link rel="apple-touch-icon" href={siteAssets.appleTouchIcon} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={htmlLang[loc]} href={new URL(switchLocalePath(Astro.url.pathname, loc), Astro.site)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} t={t} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} t={t} />
  </body>
</html>
