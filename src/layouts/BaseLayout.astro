---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Žmogaus vidinių resursų valdymo metodika Hypercube" } = Astro.props;
---

<!doctype html>
<html lang="lt-LT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/wp-content/uploads/2023/01/cropped-hypercube-32x32.png" sizes="32x32" />
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <img src="/wp-content/uploads/2022/09/paveikslelis-i-logo_.png" alt="Hypercube" width="80" height="80" />
      </a>
      <nav>
        <a href="/">Pradžia</a>
        <a href="/author-and-instructors/">Autorius ir instruktoriai</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Hypercube</p>
    </footer>
  </body>
</html>
