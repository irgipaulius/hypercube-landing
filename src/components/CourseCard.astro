---
import type { Course } from "../data/site";

interface Props {
  course: Course;
  index: number;
}

const { course, index } = Astro.props;
const reversed = index % 2 === 1;
---

<article
  class:list={[
    "grid items-center gap-8 rounded-3xl border border-border bg-surface-elevated p-6 shadow-sm md:grid-cols-2 md:gap-10 md:p-8",
    reversed && "md:[direction:rtl] md:*:[direction:ltr]",
  ]}
>
  <div class="overflow-hidden rounded-2xl bg-ink/5 aspect-square max-w-sm mx-auto w-full">
    {
      course.media.type === "video" ? (
        <video
          src={course.media.src}
          autoplay
          loop
          muted
          playsinline
          class="h-full w-full object-cover"
          aria-label={course.media.alt}
        />
      ) : (
        <img
          src={course.media.src}
          alt={course.media.alt ?? course.title}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      )
    }
  </div>

  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">{course.subtitle}</p>
    <h3 class="mt-2 font-display text-2xl font-semibold text-ink md:text-3xl">„{course.title}"</h3>

    {course.prerequisite && (
      <p class="mt-3 rounded-lg bg-gold/10 px-3 py-2 text-sm text-ink-muted">{course.prerequisite}</p>
    )}

    <div class="mt-4 space-y-3 text-ink-muted leading-relaxed">
      {course.description.map((p) => <p>{p}</p>)}
    </div>

    {
      course.benefits && course.benefits.length > 0 && (
        <ul class="mt-5 space-y-2">
          {course.benefits.map((b) => (
            <li class="flex gap-2 text-sm text-ink-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {b}
            </li>
          ))}
        </ul>
      )
    }

    {
      course.appLink && (
        <p class="mt-5 text-sm">
          <a
            href={course.appLink}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent"
          >
            „3D Hypercube" aplikacija Android
          </a>
        </p>
      )
    }

    <dl class="mt-6 grid gap-3 rounded-xl bg-surface p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-ink">Formatas</dt>
        <dd class="text-ink-muted">{course.format}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-semibold text-ink">Tvarkaraštis</dt>
        <dd class="text-ink-muted">{course.schedule}</dd>
      </div>
    </dl>
  </div>
</article>
