---
import type { Translation } from "../i18n";

type CourseWithMedia = ReturnType<typeof import("../i18n").getCourseWithMedia>;

interface Props {
  course: CourseWithMedia;
  labels: Translation["common"];
  index: number;
}

const { course, labels, index } = Astro.props;
const reversed = index % 2 === 1;
const step = String(index + 1).padStart(2, "0");
---

<article
  class:list={[
    "group relative overflow-hidden rounded-2xl bg-surface-elevated",
    "ring-1 ring-border shadow-md",
    "md:grid md:items-center md:gap-10 md:rounded-3xl md:p-8 md:shadow-sm",
    "md:grid-cols-2 md:ring-0",
    reversed && "md:[direction:rtl] md:*:[direction:ltr]",
  ]}
>
  <!-- Mobile: compact top banner + step badge -->
  <div class="relative md:hidden">
    <div class="h-36 w-full overflow-hidden bg-ink/5 sm:h-40">
      {
        course.media.type === "video" ? (
          <video
            src={course.media.src}
            autoplay
            loop
            muted
            playsinline
            class="h-full w-full object-cover"
            aria-label={course.media.alt}
          />
        ) : (
          <img src={course.media.src} alt={course.media.alt} class="h-full w-full object-cover" loading="lazy" />
        )
      }
    </div>
    <div
      class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-ink/80 text-sm font-bold text-white backdrop-blur-sm"
      aria-hidden="true"
    >
      {step}
    </div>
  </div>

  <!-- Desktop: full media column -->
  <div class="hidden overflow-hidden rounded-2xl bg-ink/5 aspect-square max-w-sm mx-auto w-full md:block">
    {
      course.media.type === "video" ? (
        <video
          src={course.media.src}
          autoplay
          loop
          muted
          playsinline
          class="h-full w-full object-cover"
          aria-label={course.media.alt}
        />
      ) : (
        <img src={course.media.src} alt={course.media.alt} class="h-full w-full object-cover" loading="lazy" />
      )
    }
  </div>

  <div class="border-t border-border p-5 md:border-t-0 md:p-0">
    <!-- Mobile title row with accent bar -->
    <div class="mb-3 flex items-start gap-3 md:mb-0">
      <span class="mt-1 hidden h-full w-1 shrink-0 rounded-full bg-accent md:block" aria-hidden="true"></span>
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">{course.subtitle}</p>
        <h3 class="mt-1 font-display text-xl font-semibold text-ink md:mt-2 md:text-3xl">{course.title}</h3>
      </div>
    </div>

    {course.prerequisite && (
      <p class="mb-3 rounded-lg bg-gold/10 px-3 py-2 text-xs leading-snug text-ink-muted md:mt-3 md:text-sm">
        {course.prerequisite}
      </p>
    )}

    <div class="space-y-2 text-sm leading-relaxed text-ink-muted md:mt-4 md:space-y-3 md:text-base">
      {course.description.map((p) => <p>{p}</p>)}
    </div>

    {
      course.benefits && course.benefits.length > 0 && (
        <ul class="mt-4 space-y-1.5 md:mt-5 md:space-y-2">
          {course.benefits.map((b) => (
            <li class="flex gap-2 text-xs text-ink-muted md:text-sm">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {b}
            </li>
          ))}
        </ul>
      )
    }

    {
      course.appLink && course.appLinkLabel && (
        <p class="mt-4 text-xs md:mt-5 md:text-sm">
          <a
            href={course.appLink}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent"
          >
            {course.appLinkLabel}
          </a>
        </p>
      )
    }

    <dl class="mt-4 grid gap-2 rounded-xl bg-surface p-3 text-xs md:mt-6 md:gap-3 md:p-4 md:text-sm sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-ink">{labels.format}</dt>
        <dd class="text-ink-muted">{course.format}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-semibold text-ink">{labels.schedule}</dt>
        <dd class="text-ink-muted">{course.schedule}</dd>
      </div>
    </dl>
  </div>
</article>
