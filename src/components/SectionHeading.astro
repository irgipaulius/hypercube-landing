---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  id?: string;
}

const { eyebrow, title, description, align = "left", id } = Astro.props;
---

<div
  id={id}
  class:list={["mb-8 max-w-3xl scroll-mt-24 sm:mb-10", align === "center" && "mx-auto text-center"]}
>
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-accent sm:text-sm">{eyebrow}</p>}
  <h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl md:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-ink-muted sm:mt-4 sm:text-lg">{description}</p>}
</div>
