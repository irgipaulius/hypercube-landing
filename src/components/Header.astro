---
import { site, nav } from "../data/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-surface/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="group flex items-center gap-3 no-underline">
      <img
        src={site.logo}
        alt={site.name}
        width="44"
        height="44"
        class="rounded-xl shadow-sm transition group-hover:scale-105"
      />
      <span class="hidden font-display text-lg font-semibold text-ink sm:block">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Pagrindinis meniu">
      {
        nav.map(({ href, label }) => {
          const isActive = href.startsWith("/author")
            ? currentPath.startsWith("/author")
            : href === "/" || href.startsWith("/#")
              ? currentPath === "/"
              : currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium transition",
                isActive ? "bg-accent/10 text-accent" : "text-ink-muted hover:bg-black/5 hover:text-ink",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded-lg border border-border bg-surface-elevated px-3 py-2 text-sm font-medium text-ink">
        Meniu
      </summary>
      <nav class="absolute right-0 mt-2 w-56 rounded-xl border border-border bg-surface-elevated p-2 shadow-lg" aria-label="Mobilus meniu">
        {
          nav.map(({ href, label }) => (
            <a href={href} class="block rounded-lg px-3 py-2 text-sm text-ink-muted hover:bg-accent/10 hover:text-accent">
              {label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
