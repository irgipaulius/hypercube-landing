---
import type { Translation } from "../i18n";

interface Props {
  items: Translation["testimonials"];
  labels: Translation["common"];
}

const { items, labels } = Astro.props;
---

<section class="relative" aria-label={labels.testimonialSelect}>
  <div class="overflow-hidden rounded-3xl border border-border bg-surface-elevated p-8 md:p-12">
    {
      items.map((item, i) => (
        <blockquote
          data-slide={i}
          class:list={["testimonial-slide transition-opacity duration-500", i === 0 ? "block opacity-100" : "hidden opacity-0"]}
        >
          <p class="font-display text-xl leading-relaxed text-ink md:text-2xl">"{item.quote}"</p>
          <footer class="mt-6 text-sm font-semibold text-accent">— {item.author}</footer>
        </blockquote>
      ))
    }
  </div>

  <div class="mt-6 flex items-center justify-center gap-4">
    <button
      type="button"
      data-prev
      class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-surface-elevated text-ink transition hover:border-accent hover:text-accent"
      aria-label={labels.testimonialPrev}
    >
      ←
    </button>
    <div class="flex gap-2" role="tablist">
      {
        items.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            class:list={["h-2 rounded-full transition-all", i === 0 ? "w-8 bg-accent" : "w-2 bg-border hover:bg-accent/50"]}
            aria-label={`${labels.testimonialSelect} ${i + 1}`}
          />
        ))
      }
    </div>
    <button
      type="button"
      data-next
      class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-surface-elevated text-ink transition hover:border-accent hover:text-accent"
      aria-label={labels.testimonialNext}
    >
      →
    </button>
  </div>
</section>

<script>
  function initSlider(root: HTMLElement) {
    const slides = [...root.querySelectorAll<HTMLElement>(".testimonial-slide")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    let current = 0;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle("hidden", !active);
        slide.classList.toggle("block", active);
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        dot.setAttribute("aria-selected", String(active));
        dot.classList.toggle("w-8", active);
        dot.classList.toggle("bg-accent", active);
        dot.classList.toggle("w-2", !active);
        dot.classList.toggle("bg-border", !active);
      });
    }

    prev?.addEventListener("click", () => show(current - 1));
    next?.addEventListener("click", () => show(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));
  }

  document.querySelectorAll<HTMLElement>("section[aria-label]").forEach((el) => {
    if (el.querySelector(".testimonial-slide")) initSlider(el);
  });
</script>
