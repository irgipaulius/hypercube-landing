---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CourseCard from "../../components/CourseCard.astro";
import TestimonialSlider from "../../components/TestimonialSlider.astro";
import {
  getCourseWithMedia,
  getTranslation,
  isLocale,
  localePath,
  locales,
  siteAssets,
  type Locale,
} from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang!;
if (!isLocale(lang)) return Astro.redirect("/lt/");

const locale = lang as Locale;
const t = getTranslation(locale);
const courses = t.courses.map(getCourseWithMedia);
---

<BaseLayout locale={locale} t={t} title={t.site.name}>
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      aria-hidden="true"
      style="background-image: radial-gradient(circle at 20% 20%, rgba(91,75,183,0.15), transparent 40%), radial-gradient(circle at 80% 0%, rgba(201,162,39,0.12), transparent 35%);"
    />
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-24">
      <div class="animate-fade-up">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent">
          {t.home.heroEyebrow}
        </p>
        <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight text-ink md:text-5xl lg:text-6xl">
          {t.site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">{t.site.description}</p>
        <p class="mt-3 text-sm text-ink-muted">
          {t.site.author}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="#kursai"
            class="inline-flex items-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition hover:bg-accent-light"
          >
            {t.home.ctaCourses}
          </a>
          <a
            href={localePath(locale, "author-and-instructors")}
            class="inline-flex items-center rounded-full border border-border bg-surface-elevated px-6 py-3 text-sm font-semibold text-ink transition hover:border-accent hover:text-accent"
          >
            {t.home.ctaTeam}
          </a>
        </div>
      </div>

      <div class="animate-fade-up animate-fade-up-delay-2 relative mx-auto w-full max-w-md">
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-accent/20 to-gold/20 blur-2xl" aria-hidden="true" />
        <img
          src={siteAssets.logo}
          alt={t.common.logoAlt}
          width="550"
          height="550"
          class="relative rounded-[2rem] border border-border bg-surface-elevated p-8 shadow-xl"
        />
      </div>
    </div>
  </section>

  <section id="apie" class="mx-auto max-w-6xl px-5 py-20 md:py-28 scroll-mt-24">
    <SectionHeading
      eyebrow={t.home.aboutEyebrow}
      title={t.home.aboutTitle}
      description={t.home.aboutDescription}
    />
    <div class="grid gap-6 md:grid-cols-3">
      {t.intro.map((paragraph) => (
        <p class="rounded-2xl border border-border bg-surface-elevated p-6 text-ink-muted leading-relaxed shadow-sm">
          {paragraph}
        </p>
      ))}
    </div>
  </section>

  <section id="kursai" class="border-y border-border bg-white/50 py-20 md:py-28 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-5">
      <SectionHeading
        eyebrow={t.home.coursesEyebrow}
        title={t.home.coursesTitle}
        description={t.home.coursesDescription}
        align="center"
      />
      <div class="space-y-10">
        {courses.map((course, index) => (
          <CourseCard course={course} labels={t.common} index={index} />
        ))}
      </div>
    </div>
  </section>

  <section id="atsiliepimai" class="mx-auto max-w-4xl px-5 py-20 md:py-28 scroll-mt-24">
    <SectionHeading
      eyebrow={t.home.testimonialsEyebrow}
      title={t.home.testimonialsTitle}
      description={t.home.testimonialsDescription}
      align="center"
    />
    <TestimonialSlider items={t.testimonials} labels={t.common} />
  </section>

  <section class="border-t border-border bg-ink py-16 text-white md:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="font-display text-3xl font-semibold md:text-4xl">{t.home.ctaTitle}</h2>
      <p class="mt-4 text-white/70">{t.home.ctaDescription}</p>
      <a
        href={localePath(locale, "author-and-instructors")}
        class="mt-8 inline-flex items-center rounded-full bg-gold px-8 py-3 text-sm font-semibold text-ink transition hover:bg-gold-light"
      >
        {t.home.ctaButton}
      </a>
    </div>
  </section>
</BaseLayout>
