---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PersonCard from "../../components/PersonCard.astro";
import { author, instructors } from "../../data/site";
---

<BaseLayout
  title="Autorius ir instruktoriai"
  description="Hypercube metodikos autorius Tomas Jacinkevičius ir sertifikuoti Tesseract instruktoriai."
>
  <section class="border-b border-border bg-gradient-to-b from-accent/5 to-transparent py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <SectionHeading
        eyebrow="Komanda"
        title="Autorius ir instruktoriai"
        description="Susisiekite tiesiogiai — kiekvienas instruktorius veda Tesseract kursus savo regione."
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h2 class="mb-8 font-display text-2xl font-semibold text-ink">Autorius</h2>
    <div class="grid gap-8">
      <PersonCard person={author} featured />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 md:pb-28">
    <h2 class="mb-8 font-display text-2xl font-semibold text-ink">Instruktoriai</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {instructors.map((person) => <PersonCard person={person} />)}
    </div>
  </section>
</BaseLayout>
